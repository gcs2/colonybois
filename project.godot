; Frontier Worlds — pinned to Godot 4.7.2 stable
config_version=5

[application]
config/name="Frontier Worlds"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"

[audio]

general/text_to_speech=true

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"

[gui]
timers/tooltip_delay_sec=0.0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025,0.045,0.075,1)
textures/default_filters/use_nearest_mipmap_filter=false

[application_metadata]
engine_version="4.7.2-stable"
